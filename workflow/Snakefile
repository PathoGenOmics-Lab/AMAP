import os
import glob
configfile: "config.yaml"

FASTA_DIR = config["fasta_dir"]
DB_FALLBACK = "out/downloads/db_fallback"
FILES = {
    "nt_correctedH37Rv.fa": "https://zenodo.org/record/8024447/files/nt_correctedH37Rv.fa",
    "new_refH37Rv.fasta": "https://zenodo.org/record/8024447/files/new_refH37Rv.fasta",
    "bad.bakta.fa": "https://zenodo.org/record/8024447/files/bad.bakta.fa",
    "sequence.gb": "https://zenodo.org/record/8024447/files/sequence.gb",
    "snps_lineages.tsv": "https://zenodo.org/record/8232692/files/snps_lineages.tsv",
    "MTB_ancestor_reference.fasta": "https://zenodo.org/record/3497110/files/MTB_ancestor_reference.fasta"
}
FASTA_FILES = {f: url for f, url in FILES.items() if f.endswith(".fasta") or f.endswith(".tsv")}
def get_db_path():
    db_type = config.get("db_type", "light")
    if "db" in config:
        return config["db"]
    else:
        return os.path.join(DB_FALLBACK, "db-" + db_type)

def needs_db_download():
    return "db" not in config

rule all:
    input:
        #expand("out/mtb_typer/{fasta}/", fasta=[os.path.splitext(f)[0] for f in os.listdir(FASTA_DIR) if f.endswith('.fasta')]),
        expand("out/AMAP/{fasta}.AMAP/{fasta}.clusters", fasta=[os.path.splitext(f)[0] for f in os.listdir(FASTA_DIR) if f.endswith('.fasta')])

rule download_reference:
    output:
        file="out/downloads/reference/{file}"
    params:
        url=lambda wildcards: FILES[wildcards.file]
    shell:
        "wget -O {output.file} {params.url}"

rule blast_database:
    input:
        ref_multifa="out/downloads/reference/{fasta_file}"
    output:
        directory("out/downloads/reference/blast_{fasta_file}.blastdb")
    conda:
        "envs/chk_cases.yaml"
    params:
        basename="out/downloads/reference/blast_{fasta_file}.blastdb/{fasta_file}"
    shell:
        """
        makeblastdb -in {input.ref_multifa} -dbtype nucl -out {params.basename}
        """

rule download_bakta_db:
    output:
        directory(DB_FALLBACK)
    params:
        type=config.get("db_type", "light")
    conda:
        "envs/bakta.yaml"
    shell:
        """
        bakta_db download --output {output} --type {params.type}
        """
rule mtb_typer:
    input:
        MTB_ancestor_reference="out/downloads/reference/MTB_ancestor_reference.fasta",
        snps_lineages="out/downloads/reference/snps_lineages.tsv",
        fasta=lambda wildcards: os.path.join(FASTA_DIR, f"{wildcards.fasta}.fasta")
    output:
        directory("out/mtb_typer/{fasta}")
    shell:
        """
        python scripts/mtb_typer.py -i {input.fasta} -r {input.MTB_ancestor_reference} -t {input.snps_lineages} -o 'out/mtb_typer/{wildcards.fasta}'
        """

def get_fasta_from_directory(wildcards):
    fasta_files = glob.glob(f"out/mtb_typer/{wildcards.fasta}/*.fasta")
    if fasta_files:
        return fasta_files[0]
    else:
        raise ValueError(f"No FASTA file found in out/mtb_typer/{wildcards.fasta}/")
def get_fasta_prefix(wildcards):
    fasta_path = get_fasta_from_directory(wildcards)
    return os.path.splitext(os.path.basename(fasta_path))[0]
    
rule run_bakta:
    input:
        mtb_typer= "out/mtb_typer/{fasta}",
        proteins="out/downloads/reference/sequence.gb",
        db_download=rules.download_bakta_db.output if needs_db_download() else None
    output:
        directory("out/bakta_output/{fasta}.bakta")
    params:
        db=get_db_path()
    conda:
        "envs/bakta.yaml"
    shell:
        """
        echo "Running bakta on {input.mtb_typer}"
        # Obtener el nombre del archivo fasta usando glob
        fasta_file=$(ls out/mtb_typer/{wildcards.fasta}/*.fasta | head -1)
        if [ ! -f "$fasta_file" ]; then
            echo "No FASTA file found in out/mtb_typer/{wildcards.fasta}/"
            exit 1
        fi
        
        # Obtener el prefijo del archivo FASTA para usarlo como prefix y locus_tag
        prefix=$(basename $fasta_file .fasta)
        
        bakta --db {params.db} --verbose --output {output} --prefix $prefix --locus-tag $prefix --proteins {input.proteins} $fasta_file
        """


rule classify_cases:
    input:
        bakta_dir="out/bakta_output/{fasta}.bakta",
        ref_blast = "out/downloads/reference/blast_nt_correctedH37Rv.fa.blastdb",
    output:
        "out/AMAP/{fasta}.AMAP/{fasta}_classifiedcases.tsv",
        "out/AMAP/{fasta}.AMAP/{fasta}_case1.bakta.fa",
        "out/AMAP/{fasta}.AMAP/{fasta}_case2.bakta.fa",
        "out/AMAP/{fasta}.AMAP/{fasta}_case3.bakta.fa",
        "out/AMAP/{fasta}.AMAP/{fasta}_case4.bakta.fa"
    conda:
        "envs/chk_cases.yaml"
    shell:
        """
        fasta_file=$(ls out/mtb_typer/{wildcards.fasta}/*.fasta | head -1)
        if [ ! -f "$fasta_file" ]; then
            echo "No FASTA file found in out/mtb_typer/{wildcards.fasta}/"
            exit 1
        fi        
        python scripts/classify_cases.py -f $fasta_file -p out/AMAP/{wildcards.fasta}.AMAP/ -b {input.ref_blast}/nt_correctedH37Rv.fa
        """

rule validate_case1:
    input:
        case1 = "out/AMAP/{fasta}.AMAP/{fasta}_case1.bakta.fa",
        ref_fasta = "out/downloads/reference/blast_new_refH37Rv.fasta.blastdb",
        ref_bad = "out/downloads/reference/blast_bad.bakta.fa.blastdb"
    output:
        "out/AMAP/{fasta}.AMAP/{fasta}_case1.final.tsv"
    conda:
        "envs/chk_cases.yaml"
    shell:
        """
        python scripts/validate_case1.py -n {wildcards.fasta} -p out/AMAP/{wildcards.fasta}.AMAP/ -b {input.ref_bad}/bad.bakta.fa -r {input.ref_fasta}/new_refH37Rv.fasta
        """

rule bakta_multifa:
    input:
        case1_fix = "out/AMAP/{fasta}.AMAP/{fasta}_case1.final.tsv",
        case1 = "out/AMAP/{fasta}.AMAP/{fasta}_case1.bakta.fa",
        case2 = "out/AMAP/{fasta}.AMAP/{fasta}_case2.bakta.fa",
        case3 = "out/AMAP/{fasta}.AMAP/{fasta}_case3.bakta.fa",
        case4 = "out/AMAP/{fasta}.AMAP/{fasta}_case4.bakta.fa"
    output:
        "out/AMAP/{fasta}.AMAP/{fasta}-complete.fa"
    conda:
        "envs/chk_cases.yaml"
    shell:
        """
        fasta_file=$(ls out/mtb_typer/{wildcards.fasta}/*.fasta | head -1)
        if [ ! -f "$fasta_file" ]; then
            echo "No FASTA file found in out/mtb_typer/{wildcards.fasta}/"
            exit 1
        fi
        python scripts/generate_casesmultifa.py -n $fasta_file -p "out/AMAP/{wildcards.fasta}.AMAP/" -p2 out/bakta_output/{wildcards.fasta}.bakta/
        """

rule H37Rv_clusters:
    input:
        multifa_bakta = "out/AMAP/{fasta}.AMAP/{fasta}-complete.fa",
        multifa_h37rv = "out/downloads/reference/nt_correctedH37Rv.fa"
    output:
        "out/AMAP/{fasta}.AMAP/{fasta}.clusters"
    conda:
        "envs/chk_cases.yaml"
    shell:
        """
        python scripts/clusters.py -n {wildcards.fasta} -f {input.multifa_h37rv} -p out/AMAP/{wildcards.fasta}.AMAP/
        """

ruleorder: blast_database > download_reference
ruleorder: mtb_typer > bakta_multifa