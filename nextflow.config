/*
========================================================================================
    AMAP Pipeline - Nextflow Configuration
========================================================================================
    Default configuration options for all environments.
    This file is structured with profiles to make the pipeline portable.
    A user can choose a profile with the `-profile` option when running Nextflow.
    
    Usage examples:
    nextflow run main.nf -profile standard
    nextflow run main.nf -profile docker
    nextflow run main.nf -profile singularity,slurm
----------------------------------------------------------------------------------------
*/

// --- Manifest ---
manifest {
    name            = 'PathoGenOmics-Lab/AMAP'
    author          = 'Paula Ruiz-Rodriguez'
    description     = 'Assisted Microbial Annotator Pipeline'
    mainScript      = 'main.nf'
    version         = '1.0.1'
    nextflowVersion = '>=24.04.0'
    doi             = 'https://doi.org/10.5281/zenodo.8024446'
    homePage        = 'https://github.com/PathoGenOmics-Lab/AMAP'
    defaultBranch   = 'main'
}

// --- Global Parameters ---
// The default values for the pipeline's parameters are defined here.
// They can be overridden from the command line (e.g., --outdir my_results).
params {
    // No sample sheet ships with the pipeline. `-profile test` needs none:
    // it annotates the reference genome bundled in the container.
    tsv = 'samples.tsv'
    outdir = 'results'
    eggnog_db = 'eggnog_db'
    // max_cpus, max_memory and max_time, the caps on what any one task may
    // ask for (see resourceLimits below), are set at the end of this file,
    // after the profiles, from these three. Each needs its value here: a run
    // on Nextflow 24.04 stops at a param the config reads without setting.
    scheduler = null   // the scheduler profile on: slurm, sge, pbs or lsf
    test_data = false  // -profile test: the genome bundled in the container
    highmem = false    // -profile highmem
    scratch = false  // Use node-local scratch (set true for NFS/Lustre clusters)
    // Names this run's execution report, timeline, trace and DAG (below), so
    // a resumed run does not overwrite the previous one's.
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}


// --- Default Process Configuration ---
// Defines the default resources and behavior for each process.
// Profiles can override these values.
process {
    // No task gets more than --max_cpus, --max_memory or --max_time: a larger
    // request, including memory grown by task.attempt on a retry, is lowered
    // to the cap. A closure, so the caps are read when each task starts, after
    // the profiles, any -c config and the command line have all had their say.
    resourceLimits = {
        [
            cpus  : params.max_cpus as int,
            memory: params.max_memory as nextflow.util.MemoryUnit,
            time  : params.max_time as nextflow.util.Duration
        ]
    }

    // Default resources for a local run. These and the ones below are
    // requests, capped by resourceLimits above.
    cpus   = 2
    memory = { 6.GB * task.attempt }
    time   = 4.h

    // Error handling: retry once on transient failures, then ignore the
    // sample so one bad genome doesn't kill a 500-sample run.
    // Per-sample processes use 'ignore' after retries; singleton processes
    // (EGGNOG_DB, GET_ALLDUP, FINAL_REPORT) use 'retry' only.
    // Exit codes: 137=OOM-killed, 140=timeout, 143=SIGTERM
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : (task.attempt <= 2 ? 'retry' : 'ignore') }
    maxRetries = 2

    // Shell to be used for executing scripts.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Node-local scratch (critical for NFS/Lustre — avoids metadata storms)
    scratch = params.scratch

    // --- Per-sample processes: scale memory on retry, ignore after exhaustion ---

    withName: 'BAKTA_ANNOTATOR' {
        cpus   = 12
        memory = { 6.GB * task.attempt }
        time   = { task.attempt > 1 ? 4.h : 2.h }
        clusterOptions = '--qos=medium'
    }
    withName: 'MINIPROT' {
        cpus   = 6
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withName: 'TYPE_CASES' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.m
    }
    withName: 'FIX_CDS' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.m
    }
    withName: 'PATHOTYPR' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.m
    }
    withName: 'GET_DUPLICATIONS' {
        cpus   = 6
        memory = { 10.GB * task.attempt }
        time   = 1.h
    }
    withName: 'GET_COUNT' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = 15.m
    }
    withName: 'GET_OUTPUTS' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.m
    }
    withName: 'PANGENE' {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = 3.h
    }
    withName: 'PANGENE_GENOME' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = 15.m
    }

    // --- Singleton processes: retry only (never ignore) ---

    withName: 'EGGNOG_DB' {
        cpus   = 16
        memory = { 45.GB * task.attempt }
        time   = 6.h
        scratch = false  // storeDir is incompatible with node-local scratch
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'ANNOT_EGGNOGMAP_BATCH' {
        cpus   = 24
        memory = { 50.GB * task.attempt }
        time   = { task.attempt > 1 ? 12.h : 8.h }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'GET_ALLDUP' {
        cpus   = 13
        memory = { 10.GB * task.attempt }
        time   = 4.h
        errorStrategy = 'retry'
    }
    withName: 'PREPARE_REFERENCE' {
        cpus   = 8
        memory = { 6.GB * task.attempt }
        time   = 2.h
        errorStrategy = 'retry'
    }
    withName: 'REPORT_INPUTS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 1.h
        errorStrategy = 'retry'
    }
    withName: 'FINAL_REPORT' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 2.h
        errorStrategy = 'retry'
    }

    // --- Infrastructure processes: always local ---

    withName: 'VALIDATE_INPUTS' {
        executor = 'local'
        cpus = 1
        memory = '512.MB'
        errorStrategy = 'terminate'
    }
    withName: 'SOFTWARE_VERSIONS' {
        executor = 'local'
        cpus = 1
        memory = '256.MB'
    }
    withName: 'DUMP_PARAMS' {
        executor = 'local'
        cpus = 1
        memory = '128.MB'
    }
}

// --- Task Environment ---
// No task may write into the pipeline itself. bin/ is on every task's PATH,
// mounted read-write into its container, and Python used to cache the
// bytecode of AMAP's own modules there, in bin/classify/__pycache__, the
// first time a copy of AMAP ran TYPE_CASES.
// Nextflow adds every bin/ entry whose name appears as a word in a script to
// that task's cache key, and PATHOTYPR runs `pathotypr classify`, so the
// directory changing voided PATHOTYPR's cache: the first -resume re-ran it,
// Bakta and everything after them, on every sample.
env {
    PYTHONDONTWRITEBYTECODE = '1'
}


// --- Execution Profiles ---
// Profiles allow adapting the execution to different systems (local, cluster, etc.).
// Each sets one kind of thing: where the tools come from (standard, docker,
// singularity), what runs the tasks (slurm, sge, pbs, lsf), or the size of the
// run (test, highmem). None sets the resource caps: those are worked out after
// this block, so the order of -profile does not change them.
//
// USAGE EXAMPLES:
//
//   # Local laptop/workstation with Docker:
//   nextflow run PathoGenOmics-Lab/AMAP -profile docker --tsv samples.tsv
//
//   # Local laptop with Singularity:
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity --tsv samples.tsv
//
//   # HPC cluster with SLURM + Singularity (most common):
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv samples.tsv
//
//   # HPC with custom resources:
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
//       --tsv samples.tsv --max_cpus 48 --max_memory 128.GB
//
//   # Skip typing for non-MTBC organisms:
//   nextflow run PathoGenOmics-Lab/AMAP -profile docker \
//       --tsv samples.tsv --skip_typing --skip_mycobrowser \
//       --genus Escherichia --species "Escherichia coli" \
//       --ref_annotation ref.gbk --ref_genome ref.fasta
//
profiles {

    // -----------------------------------------------------------------------
    // LOCAL PROFILES — for laptops, workstations, single machines
    // -----------------------------------------------------------------------

    // Standard local execution (no container — all tools must be in PATH)
    standard {
        // Nothing to set: tasks run the tools on PATH, as Nextflow does by default.
    }

    // Docker — recommended for local machines
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
        process.container = 'paururo/amap:latest'
    }

    // Singularity — for machines where Docker is not available
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${params.outdir}/singularity_cache"
        process.container = 'paururo/amap:latest'
    }

    // -----------------------------------------------------------------------
    // HPC PROFILES — combine with a container profile (e.g., singularity,slurm)
    //
    // USAGE EXAMPLES:
    //   # SLURM + Singularity (most common):
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv s.tsv
    //
    //   # SLURM with node-local scratch (recommended for NFS):
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
    //       --scratch true --tsv samples.tsv
    //
    //   # Large-memory node for eggNOG:
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
    //       --max_cpus 48 --max_memory 256.GB --tsv samples.tsv
    // -----------------------------------------------------------------------

    // SLURM — generic HPC profile
    slurm {
        process.executor = 'slurm'
        // Let Nextflow submit up to 200 jobs at once (tune per cluster policy)
        executor.queueSize = 200
        // Rate-limit submissions to avoid overwhelming SLURM controller
        executor.submitRateLimit = '100/1min'
        // Poll interval for job status
        executor.pollInterval = '10 sec'
        // Retry interval after transient errors (e.g., SLURM controller overload)
        executor.exitReadTimeout = '30 min'
        // A cluster node's caps, set after the profiles (override with --max_cpus / --max_memory)
        params.scheduler = 'slurm'
        // Enable node-local scratch by default on SLURM (avoids NFS metadata storms)
        params.scratch = true
        // Lenient caching: tolerate NFS timestamp drift across nodes
        process.cache = 'lenient'
    }

    // SGE — Sun Grid Engine / Univa Grid Engine
    sge {
        process.executor = 'sge'
        process.penv = 'smp'
        process.clusterOptions = { "-l h_vmem=${task.memory.toGiga()}G" }
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.scheduler = 'sge'
        params.scratch = true
    }

    // PBS/Torque
    pbs {
        process.executor = 'pbs'
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.scheduler = 'pbs'
        params.scratch = true
    }

    // LSF — IBM Spectrum LSF
    lsf {
        process.executor = 'lsf'
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.scheduler = 'lsf'
        params.scratch = true
    }

    // -----------------------------------------------------------------------
    // CONVENIENCE PROFILES — combine with the above
    // -----------------------------------------------------------------------

    // Test profile — small dataset, minimal resources, for CI/CD
    test {
        // No sample sheet: the genome comes out of the container, so this
        // works from a bare `nextflow run PathoGenOmics-Lab/AMAP` with nothing
        // downloaded and nothing on disk. Combine with a container profile.
        // A small run's caps go with it, set after the profiles.
        params.test_data = true
    }

    // Large-memory profile — for nodes with lots of RAM (eggNOG batch mode)
    highmem {
        params.highmem = true
    }
}

// --- Resource caps ---
// The most any one task may ask for (resourceLimits, above). The first that
// applies sets them: -profile highmem, -profile test, a scheduler profile
// (slurm, sge, pbs, lsf), and otherwise this machine. They are set here, after
// the profiles, and not in them, because Nextflow 25.10 and later apply
// profiles in the order -profile names them, the last one winning (24.04 in
// the order this file defines them): when the container profiles set a
// laptop's 16 GB, `-profile slurm,singularity` gave a cluster run 16 GB, and
// `-profile singularity,slurm` 128 GB. --max_cpus, --max_memory and
// --max_time, on the command line or in a -c config, still win over these.
params.max_cpus   = params.highmem ? 48       : params.test_data ? 4      : params.scheduler ? 48       : Runtime.runtime.availableProcessors()
params.max_memory = params.highmem ? '256.GB' : params.test_data ? '8.GB' : params.scheduler ? '128.GB' : '16.GB'
params.max_time   = params.highmem ? '120.h'  : params.test_data ? '1.h'  : '72.h'


// --- JVM TUNING ---
// For large runs (500+ samples), Nextflow's JVM may need more heap.
// Set NXF_OPTS="-Xms2g -Xmx8g" before launching:
//   export NXF_OPTS="-Xms2g -Xmx8g"
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv samples.tsv
// The default JVM heap (1-2GB) is fine for <100 samples.

// --- Execution Report Configuration ---
// Generates detailed reports about the pipeline execution.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_timestamp}.html"
}
