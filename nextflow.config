/*
========================================================================================
    AMAP Pipeline - Nextflow Configuration
========================================================================================
    Default configuration options for all environments.
    This file is structured with profiles to make the pipeline portable.
    A user can choose a profile with the `-profile` option when running Nextflow.
    
    Usage examples:
    nextflow run main.nf -profile standard
    nextflow run main.nf -profile docker
    nextflow run main.nf -profile singularity,slurm
----------------------------------------------------------------------------------------
*/

// --- Manifest ---
manifest {
    name            = 'PathoGenOmics-Lab/AMAP'
    author          = 'Paula Ruiz-Rodriguez'
    description     = 'Assisted Microbial Annotator Pipeline'
    mainScript      = 'main.nf'
    version         = '1.0.1'
    nextflowVersion = '>=23.04.0'
    doi             = 'https://doi.org/10.5281/zenodo.8024446'
    homePage        = 'https://github.com/PathoGenOmics-Lab/AMAP'
    defaultBranch   = 'main'
}

// --- Global Parameters ---
// The default values for the pipeline's parameters are defined here.
// They can be overridden from the command line (e.g., --outdir my_results).
params {
    // No sample sheet ships with the pipeline. `-profile test` needs none:
    // it annotates the reference genome bundled in the container.
    tsv = 'samples.tsv'
    outdir = 'results'
    eggnog_db = 'eggnog_db'
    max_cpus = 24
    max_memory = '50.GB'
    max_time = '72.h'
    scratch = false  // Use node-local scratch (set true for NFS/Lustre clusters)
}


// --- Resource Helper Functions ---
// Ensure requested resources never exceed user-defined caps.
// Returns the minimum of the requested value and the cap parameter.
def check_max_cpus(requested) {
    return Math.min(requested as int, params.max_cpus as int)
}
def check_max_memory(requested) {
    def req_gb = (requested instanceof String) ? MemoryUnit.of(requested).toGiga() : requested
    def max_gb = MemoryUnit.of(params.max_memory).toGiga()
    return Math.min(req_gb, max_gb) + '.GB'
}
def check_max_time(requested) {
    try {
        def req = (requested instanceof String) ? Duration.of(requested) : requested
        def max = Duration.of(params.max_time)
        return req.compareTo(max) > 0 ? max : req
    } catch (e) { return params.max_time }
}

// --- Default Process Configuration ---
// Defines the default resources and behavior for each process.
// Profiles can override these values.
process {
    // Default resources for a local run.
    cpus   = { check_max_cpus(2) }
    memory = { check_max_memory(6 * task.attempt + '.GB') }
    time   = { check_max_time('4h') }

    // Error handling: retry once on transient failures, then ignore the
    // sample so one bad genome doesn't kill a 500-sample run.
    // Per-sample processes use 'ignore' after retries; singleton processes
    // (EGGNOG_DB, GET_ALLDUP, FINAL_REPORT) use 'retry' only.
    // Exit codes: 137=OOM-killed, 140=timeout, 143=SIGTERM
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : (task.attempt <= 2 ? 'retry' : 'ignore') }
    maxRetries = 2

    // Shell to be used for executing scripts.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Node-local scratch (critical for NFS/Lustre — avoids metadata storms)
    scratch = params.scratch

    // --- Per-sample processes: scale memory on retry, ignore after exhaustion ---

    withName: 'BAKTA_ANNOTATOR' {
        cpus   = { check_max_cpus(12) }
        memory = { check_max_memory(6 * task.attempt + '.GB') }
        time   = { check_max_time(task.attempt > 1 ? '4h' : '2h') }
        clusterOptions = '--qos=medium'
    }
    withName: 'MINIPROT' {
        cpus   = { check_max_cpus(6) }
        memory = { check_max_memory(2 * task.attempt + '.GB') }
        time   = { check_max_time('1h') }
    }
    withName: 'TYPE_CASES' {
        cpus   = 1
        memory = { check_max_memory(2 * task.attempt + '.GB') }
        time   = { check_max_time('30m') }
    }
    withName: 'FIX_CDS' {
        cpus   = 1
        memory = { check_max_memory(2 * task.attempt + '.GB') }
        time   = { check_max_time('30m') }
    }
    withName: 'PATHOTYPR' {
        cpus   = 1
        memory = { check_max_memory(2 * task.attempt + '.GB') }
        time   = { check_max_time('30m') }
    }
    withName: 'GET_DUPLICATIONS' {
        cpus   = { check_max_cpus(6) }
        memory = { check_max_memory(10 * task.attempt + '.GB') }
        time   = { check_max_time('1h') }
    }
    withName: 'GET_COUNT' {
        cpus   = 1
        memory = { check_max_memory(1 * task.attempt + '.GB') }
        time   = { check_max_time('15m') }
    }
    withName: 'GET_OUTPUTS' {
        cpus   = 1
        memory = { check_max_memory(2 * task.attempt + '.GB') }
        time   = { check_max_time('30m') }
    }
    withName: 'PANGENE' {
        cpus   = { check_max_cpus(16) }
        memory = { check_max_memory(16 * task.attempt + '.GB') }
        time   = { check_max_time('3h') }
    }

    // --- Singleton processes: retry only (never ignore) ---

    withName: 'EGGNOG_DB' {
        cpus   = { check_max_cpus(16) }
        memory = { check_max_memory(45 * task.attempt + '.GB') }
        time   = { check_max_time('6h') }
        scratch = false  // storeDir is incompatible with node-local scratch
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'ANNOT_EGGNOGMAP_BATCH' {
        cpus   = { check_max_cpus(24) }
        memory = { check_max_memory(50 * task.attempt + '.GB') }
        time   = { check_max_time(task.attempt > 1 ? '12h' : '8h') }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'GET_ALLDUP' {
        cpus   = { check_max_cpus(13) }
        memory = { check_max_memory(10 * task.attempt + '.GB') }
        time   = { check_max_time('4h') }
        errorStrategy = 'retry'
    }
    withName: 'PREPARE_REFERENCE' {
        cpus   = { check_max_cpus(8) }
        memory = { check_max_memory(6 * task.attempt + '.GB') }
        time   = { check_max_time('2h') }
        errorStrategy = 'retry'
    }
    withName: 'REPORT_INPUTS' {
        cpus   = 1
        memory = { check_max_memory(4 * task.attempt + '.GB') }
        time   = { check_max_time('1h') }
        errorStrategy = 'retry'
    }
    withName: 'FINAL_REPORT' {
        cpus   = 1
        memory = { check_max_memory(8 * task.attempt + '.GB') }
        time   = { check_max_time('2h') }
        errorStrategy = 'retry'
    }

    // --- Infrastructure processes: always local ---

    withName: 'VALIDATE_INPUTS' {
        executor = 'local'
        cpus = 1
        memory = '512.MB'
        errorStrategy = 'terminate'
    }
    withName: 'SOFTWARE_VERSIONS' {
        executor = 'local'
        cpus = 1
        memory = '256.MB'
    }
    withName: 'DUMP_PARAMS' {
        executor = 'local'
        cpus = 1
        memory = '128.MB'
    }
}


// --- Execution Profiles ---
// Profiles allow adapting the execution to different systems (local, cluster, etc.).
//
// USAGE EXAMPLES:
//
//   # Local laptop/workstation with Docker:
//   nextflow run PathoGenOmics-Lab/AMAP -profile docker --tsv samples.tsv
//
//   # Local laptop with Singularity:
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity --tsv samples.tsv
//
//   # HPC cluster with SLURM + Singularity (most common):
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv samples.tsv
//
//   # HPC with custom resources:
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
//       --tsv samples.tsv --max_cpus 48 --max_memory 128.GB
//
//   # Skip typing for non-MTBC organisms:
//   nextflow run PathoGenOmics-Lab/AMAP -profile docker \
//       --tsv samples.tsv --skip_typing --skip_mycobrowser \
//       --genus Escherichia --species "Escherichia coli" \
//       --ref_annotation ref.gbk --ref_genome ref.fasta
//
profiles {

    // -----------------------------------------------------------------------
    // LOCAL PROFILES — for laptops, workstations, single machines
    // -----------------------------------------------------------------------

    // Standard local execution (no container — all tools must be in PATH)
    standard {
        params.max_cpus   = Runtime.runtime.availableProcessors()
        params.max_memory = '16.GB'
    }

    // Docker — recommended for local machines
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
        process.container = 'paururo/amap:latest'
        params.max_cpus   = Runtime.runtime.availableProcessors()
        params.max_memory = '16.GB'
    }

    // Singularity — for machines where Docker is not available
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${params.outdir}/singularity_cache"
        process.container = 'paururo/amap:latest'
        params.max_cpus   = Runtime.runtime.availableProcessors()
        params.max_memory = '16.GB'
    }

    // -----------------------------------------------------------------------
    // HPC PROFILES — combine with a container profile (e.g., singularity,slurm)
    //
    // USAGE EXAMPLES:
    //   # SLURM + Singularity (most common):
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv s.tsv
    //
    //   # SLURM with node-local scratch (recommended for NFS):
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
    //       --scratch true --tsv samples.tsv
    //
    //   # Large-memory node for eggNOG:
    //   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm \
    //       --max_cpus 48 --max_memory 256.GB --tsv samples.tsv
    // -----------------------------------------------------------------------

    // SLURM — generic HPC profile
    slurm {
        process.executor = 'slurm'
        // Let Nextflow submit up to 200 jobs at once (tune per cluster policy)
        executor.queueSize = 200
        // Rate-limit submissions to avoid overwhelming SLURM controller
        executor.submitRateLimit = '100/1min'
        // Poll interval for job status
        executor.pollInterval = '10 sec'
        // Retry interval after transient errors (e.g., SLURM controller overload)
        executor.exitReadTimeout = '30 min'
        // HPC-scale defaults (override with --max_cpus / --max_memory)
        params.max_cpus   = 48
        params.max_memory = '128.GB'
        params.max_time   = '72.h'
        // Enable node-local scratch by default on SLURM (avoids NFS metadata storms)
        params.scratch = true
        // Lenient caching: tolerate NFS timestamp drift across nodes
        process.cache = 'lenient'
    }

    // SGE — Sun Grid Engine / Univa Grid Engine
    sge {
        process.executor = 'sge'
        process.penv = 'smp'
        process.clusterOptions = { "-l h_vmem=${task.memory.toGiga()}G" }
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.max_cpus   = 48
        params.max_memory = '128.GB'
        params.scratch = true
    }

    // PBS/Torque
    pbs {
        process.executor = 'pbs'
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.max_cpus   = 48
        params.max_memory = '128.GB'
        params.scratch = true
    }

    // LSF — IBM Spectrum LSF
    lsf {
        process.executor = 'lsf'
        executor.queueSize = 200
        executor.submitRateLimit = '20/1min'
        params.max_cpus   = 48
        params.max_memory = '128.GB'
        params.scratch = true
    }

    // -----------------------------------------------------------------------
    // CONVENIENCE PROFILES — combine with the above
    // -----------------------------------------------------------------------

    // Test profile — small dataset, minimal resources, for CI/CD
    test {
        params.max_cpus   = 4
        params.max_memory = '8.GB'
        params.max_time   = '1.h'
        // No sample sheet: the genome comes out of the container, so this
        // works from a bare `nextflow run PathoGenOmics-Lab/AMAP` with nothing
        // downloaded and nothing on disk. Combine with a container profile.
        params.test_data = true
    }

    // Large-memory profile — for nodes with lots of RAM (eggNOG batch mode)
    highmem {
        params.max_cpus   = 48
        params.max_memory = '256.GB'
        params.max_time   = '120.h'
    }
}


// --- JVM TUNING ---
// For large runs (500+ samples), Nextflow's JVM may need more heap.
// Set NXF_OPTS="-Xms2g -Xmx8g" before launching:
//   export NXF_OPTS="-Xms2g -Xmx8g"
//   nextflow run PathoGenOmics-Lab/AMAP -profile singularity,slurm --tsv samples.tsv
// The default JVM heap (1-2GB) is fine for <100 samples.

// --- Execution Report Configuration ---
// Generates detailed reports about the pipeline execution.
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
