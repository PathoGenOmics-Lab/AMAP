/*
========================================================================================
    AMAP Pipeline - Nextflow Configuration
========================================================================================
    Default configuration options for all compute environments.
    This file is structured to be portable. Users can specify a configuration
    profile using the `-profile` flag when running Nextflow.
    
    Examples:
    nextflow run <your_pipeline> -profile standard
    nextflow run <your_pipeline> -profile docker
    nextflow run <your_pipeline> -profile singularity,slurm
----------------------------------------------------------------------------------------
*/

// Global default parameters, used across the pipeline
params {
    // --- Input/Output options ---
    tsv = 'example_files/test.tsv'
    outdir = 'results'

    // --- General pipeline options ---
    help = false
    skip_typing = false
    genus = "Mycobacterium"
    species = "Mycobacterium tuberculosis"

    // --- Database and Reference File options ---
    // It is highly recommended to store these in a central, accessible location.
    // Users can override these paths from the command line, e.g., --eggnog_db /path/to/your/db
    eggnog_db = 'eggnog_db'
    pathotyper_snps = "reference/snps_lineages.tsv"
    pathotyper_ref = "reference/MTB_ancestor_reference.fasta"
    miniprot_ref_aa = "reference/aa_H37Rv.translated.fas"
    miniprot_ref_bad_bakta = "reference/bad.bakta.translated.fas"
    miniprot_ref_h37rv = "reference/new_refH37Rv.fasta"
    bakta_proteins = "reference/sequence.gb"
    mycobrowser_ref = "reference/Mycobacterium_tuberculosis_H37Rv_txt_v4.txt"
}

// Default process configuration
process {
    // Default resources allocated to each process.
    // These can be overridden by specific profiles.
    cpus = 2
    memory = '6.GB'

    // Define the shell to be used for all script executions.
    // The '-euo pipefail' options make scripts more robust.
    shell = ['/bin/bash', '-euo', 'pipefail']
}

// Execution profiles
profiles {

    // Standard profile for local execution (default)
    standard {
        // This profile uses the default process resources.
        // It's intended for small tests on a local machine without a container.
    }

    // Profile for execution with Docker
    docker {
        docker.enabled = true
        // Run the container as the current user to avoid permission issues.
        docker.runOptions = '-u $(id -u):$(id -g)'
        // Define the container image to be used for all processes
        process.container = 'paururo/amap:latest'
    }

    // Profile for execution with Singularity
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        // Define the container image to be used for all processes
        process.container = 'docker://paururo/amap:latest'
        // The 'runOptions' parameter can be used to pass custom options to Singularity.
        // For example, if you need to mount a specific directory that is not
        // covered by 'autoMounts' (like a shared database folder), you can use '--bind'.
        // Users should uncomment and modify the following line to fit their environment.
        // Example: singularity.runOptions = '--bind /path/on/host:/path/in/container'

    }

    // Profile for execution on a SLURM cluster
    slurm {
        process.executor = 'slurm'
        // Example cluster options. Users might need to adjust this.
        process.clusterOptions = '--qos=short'
        // It's good practice to load necessary modules for the cluster environment.
        process.beforeScript = 'module load singularity' // Example for a cluster using Singularity
    }
}

// Execution reporting configuration
// These settings generate detailed reports for pipeline execution.
// A timestamp is added to each report to prevent overwriting on re-runs.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
