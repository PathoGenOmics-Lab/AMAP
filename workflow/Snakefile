import os

configfile: "config.yaml"

FASTA_DIR = config["fasta_dir"]
DB_FALLBACK = "out/downloads/db_fallback"
FILES = {
    "nt_correctedH37Rv.fa": "https://zenodo.org/record/8024447/files/nt_correctedH37Rv.fa",
    "new_refH37Rv.fasta": "https://zenodo.org/record/8024447/files/new_refH37Rv.fasta",
    "bad.bakta.fa": "https://zenodo.org/record/8024447/files/bad.bakta.fa",
    "sequence.gb": "https://zenodo.org/record/8024447/files/sequence.gb"
}

def get_db_path():
    db_type = config.get("db_type", "light")
    if "db" in config:
        return config["db"]
    else:
        return os.path.join(DB_FALLBACK, "db-" + db_type)

def needs_db_download():
    return "db" not in config

rule all:
    input:
        expand("out/downloads/reference/{file}", file=FILES.keys()) +
        expand("out/AMAP/{fasta}.AMAP/{fasta}_classifiedcases.tsv", fasta=[os.path.splitext(f)[0] for f in os.listdir(FASTA_DIR) if f.endswith('.fasta')])

rule download_reference:
    output:
        file="out/downloads/reference/{file}"

    params:
        url=lambda wildcards: FILES[wildcards.file]
    shell:
        "wget -O {output.file} {params.url}"

rule download_bakta_db:
    output:
        directory(DB_FALLBACK)
    params:
        type=config.get("db_type", "light")
    conda:
        "envs/bakta.yaml"
    shell:
        """
        bakta_db download --output {output} --type {params.type}
        """

rule run_bakta:
    input:
        fasta=lambda wildcards: os.path.join(FASTA_DIR, f"{wildcards.fasta}.fasta"),
        proteins="out/downloads/reference/sequence.gb",
        db_download=rules.download_bakta_db.output if needs_db_download() else None
    output:
        directory("out/bakta_output/{fasta}.bakta")
    params:
        db=get_db_path(),
        prefix=lambda wildcards: wildcards.fasta,
        locus_tag=lambda wildcards: wildcards.fasta
    conda:
        "envs/bakta.yaml"
    shell:
        """
        bakta --db {params.db} --verbose --output {output} --prefix {params.prefix} --locus-tag {params.locus_tag} --proteins {input.proteins} {input.fasta}
        """
rule create_ntH37Rvdatabase:
    input:
        ref_multifa="out/downloads/reference/nt_correctedH37Rv.fa"  # Asegúrate de que esta ruta sea correcta
    output:
        directory("out/downloads/reference/ntH3Rv.blastdb")  # Asegúrate de que esta ruta sea correcta
    params:
        basename="out/downloads/reference/ntH3Rv.blastdb/ntH3Rv"  # Asegúrate de que este parámetro sea correcto
    shell:
        """
        makeblastdb -in {input} -dbtype nucl -out {params.basename}
        """

rule classify_cases:
    input:
        bakta_dir="out/bakta_output/{fasta}.bakta",
        ref_blast = "out/downloads/reference/ntH3Rv.blastdb"
    output:
        "out/AMAP/{fasta}.AMAP/{fasta}_classifiedcases.tsv"
    conda:
        "envs/chk_cases.yaml"
    shell:
        """
        python scripts/classify_cases.py -f {wildcards.fasta} -p out/AMAP/{wildcards.fasta}.AMAP/ -b {input.ref_blast}/ntH3Rv
        """
