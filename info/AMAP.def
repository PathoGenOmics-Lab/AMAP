Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update
    apt-get install -y git python3 python3-pip build-essential
    pip3 install numpy pandas scikit-learn

    # Clonar y construir miniprot
    git clone https://github.com/lh3/miniprot
    cd miniprot
    make

    # Verificar la construcción
    ls -l

    # Limpieza
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=$PATH:/miniprot