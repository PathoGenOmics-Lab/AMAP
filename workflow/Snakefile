import yaml

aa = "configs/config.yaml"

# Carga el archivo YAML de configuración
with open(aa, "r") as f:
    config = yaml.safe_load(f)

# Crear una regla de Snakemake
rule download_bakta_db:
    output:
        config["workdir"] + "/bakta_db.sqlite"
    params:
        type = config.get("db_type", "light"),
        db_dir = config.get("db_dir", "None")  # obtén db_dir desde el archivo de configuración, establece por defecto a "None" (string)
    conda:
        "envs/bakta.yaml"
    shell:   # usa la directiva shell en lugar de script para ejecutar comandos de shell
        """
        if [ "{params.db_dir}" == "None" ]; then  # usa params.db_dir en lugar de "db_dir" en config
            bakta_db download --output {output} --type {params.type}  # remueve las comillas aquí
        fi
        """
