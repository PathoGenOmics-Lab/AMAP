/*
========================================================================================
    AMAP Pipeline - Nextflow Configuration
========================================================================================
    Default configuration options for all environments.
    This file is structured with profiles to make the pipeline portable.
    A user can choose a profile with the `-profile` option when running Nextflow.
    
    Usage examples:
    nextflow run main.nf -profile standard
    nextflow run main.nf -profile docker
    nextflow run main.nf -profile singularity,slurm
----------------------------------------------------------------------------------------
*/

// --- Global Parameters ---
// The default values for the pipeline's parameters are defined here.
// They can be overridden from the command line (e.g., --outdir my_results).
params {
    tsv = 'example_files/test.tsv'
    outdir = 'results'
    eggnog_db = 'eggnog_db'
    max_cpus = 24
    max_memory = '50.GB'
}


// --- Default Process Configuration ---
// Defines the default resources and behavior for each process.
// Profiles can override these values.
process {
    // Default resources for a local run.
    cpus = 2
    memory = '6.GB'

    // Error handling: retry once on transient failures, then ignore the
    // sample so one bad genome doesn't kill a 500-sample run.
    // Per-sample processes use 'ignore' after retries; singleton processes
    // (EGGNOG_DB, GET_ALLDUP, FINAL_REPORT) use 'retry' only.
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2

    // Shell to be used for executing scripts.
    // '-euo pipefail' makes scripts fail if a command fails, which is safer.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Per-process resource overrides (capped by params.max_cpus / params.max_memory)
    withName: 'BAKTA_ANNOTATOR' {
        cpus   = { Math.min(12, params.max_cpus as int) }
        memory = '6.GB'
    }
    withName: 'EGGNOG_DB' {
        cpus   = { Math.min(16, params.max_cpus as int) }
        memory = { [45, params.max_memory.toGiga()].min() + '.GB' }
        errorStrategy = 'retry'  // singleton — must not be ignored
    }
    withName: 'ANNOT_EGGNOGMAP' {
        cpus   = { Math.min(24, params.max_cpus as int) }
        memory = { [50, params.max_memory.toGiga()].min() + '.GB' }
    }
    withName: 'GET_DUPLICATIONS' {
        cpus   = { Math.min(6, params.max_cpus as int) }
        memory = '10.GB'
    }
    withName: 'GET_ALLDUP' {
        cpus   = { Math.min(13, params.max_cpus as int) }
        memory = '10.GB'
        errorStrategy = 'retry'  // singleton — must not be ignored
    }
    withName: 'PANGENE' {
        cpus   = { Math.min(16, params.max_cpus as int) }
        memory = '16.GB'
    }
    withName: 'FINAL_REPORT' {
        errorStrategy = 'retry'  // singleton — must not be ignored
    }
    withName: 'REPORT_INPUTS' {
        errorStrategy = 'retry'  // singleton — must not be ignored
    }
}


// --- Execution Profiles ---
// Profiles allow adapting the execution to different systems (local, cluster, etc.).
profiles {

    // Profile for standard local execution (without a container)
    standard {
        // No extra configuration is needed; it uses the default values from the 'process' block.
    }

    // Profile for execution with Docker
    docker {
        docker.enabled = true
        // Runs the container with the current user to avoid permission issues.
        docker.runOptions = '-u $(id -u):$(id -g)'
        // Default container for most processes
        process.container = 'docker://paururo/amap:latest'
        // Override for processes that need specific tools not in the main image:
        // process { withName: 'PANGENE' { container = 'docker://paururo/amap-pangene:latest' } }
    }

    // Profile for execution with Singularity
    singularity {
        singularity.enabled = true
        // Automatically mounts necessary directories inside the container.
        singularity.autoMounts = true
        // Default container
        process.container = 'docker://paururo/amap:latest'
        
        // The following line is for mounting specific directories.
        // It is better for each user to uncomment and adapt it to their system if needed.
        // Example: singularity.runOptions = '--bind /path/on/host:/path/in/container'
    }

    // Profile for execution on a cluster with a SLURM queue manager
    slurm {
        process.executor = 'slurm'
        // Cluster-specific options, like the queue to send jobs to.
        process.clusterOptions = '--qos=short'
        // Script to be executed before each job, useful for loading modules.
        process.beforeScript = 'module load singularity'
    }
}


// --- Execution Report Configuration ---
// Generates detailed reports about the pipeline execution.
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
